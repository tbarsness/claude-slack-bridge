# Slack app credentials (see docs/SETUP.md)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Comma-separated Slack user IDs allowed to drive the bot.
# Anyone else who DMs the bot will be politely refused.
ALLOWED_USER_IDS=U0123456789

# Assistants this bridge serves. Each assistant has a name (used as the slash
# command, e.g. "ivy" -> /ivy) and an absolute working directory. Each Claude
# session inherits that directory's CLAUDE.md, .claude/settings.json, MCP
# servers, and skills. Names must be lowercase alphanumeric.
#
# Format: name:absolute-path,name:absolute-path
ASSISTANTS=ivy:/Users/you/projects/ivy,jude:/Users/you/projects/jude

# Assistant used for DMs and any channel without an explicit mapping below.
# Optional. In a multi-bridge setup (one bridge per machine, all connected to
# the same Slack app), only the instance hosting the DM-handling assistant
# should set this; other instances stay silent on plain DMs.
DEFAULT_ASSISTANT=ivy

# Optional: pin specific channels to specific assistants. Any message in a
# mapped channel routes to that assistant — a plain top-level message, a
# /<assistant> slash command, or an address prefix — and thread replies stay
# with it. Invite the bot to each mapped channel so it can see the messages.
# (In DMs, DEFAULT_ASSISTANT is used unless overridden by /<assistant>.)
#
# Format: channelId:assistantName,channelId:assistantName
# CHANNEL_ASSISTANTS=C0123456789:jude,C0987654321:ivy

# Optional: assistant names hosted by OTHER bridge instances. Listing them
# here lets this bridge recognize address-prefix mentions ("jude check this")
# as referring to a peer assistant and stay silent so the peer can answer.
# In a single-bridge setup, leave this unset.
#
# Format: comma-separated names (no paths)
# PEER_ASSISTANTS=jude

# Optional: override the system prompt sent on the first turn of every new
# thread, applied to every assistant. If unset, each assistant's CLAUDE.md is
# the only system context.
# CLAUDE_SYSTEM_PROMPT="You are responding from Slack. Keep replies concise."

# Optional: override the model. Applies to every assistant. If unset, the
# SDK default is used.
# CLAUDE_MODEL=claude-sonnet-4-6

# Where to persist the threadKey -> {sessionId, assistant} map.
# Default: ./sessions.json
# SESSIONS_FILE=./sessions.json

# Where to write logs. Default: ./logs
# LOG_DIR=./logs

# Optional: Ivy Mobile's food chat endpoint (see docs/food-chat.md). It does
# not start until FOODCHAT_SECRET is set. Bind to localhost and publish it to
# the tailnet with `tailscale serve`; never expose it on the LAN.
# FOODCHAT_ENABLED=true
# FOODCHAT_BIND_HOST=127.0.0.1
# FOODCHAT_PORT=8739
# FOODCHAT_SECRET=generate-with-openssl-rand-hex-32
# Assistant that answers the chats (its working dir and .env are used).
# FOODCHAT_ASSISTANT=ivy
# Slack channel for mirror threads. Default: the channel CHANNEL_ASSISTANTS
# maps to FOODCHAT_ASSISTANT.
# FOODCHAT_CHANNEL=C0123456789
# Transcripts and turn IDs. Default: data/food-chat next to SESSIONS_FILE.
# FOODCHAT_DATA_DIR=./data/food-chat
# Food Log exec URL for read-backs. Default: FOODLOG_EXEC_URL from the
# assistant's own .env.
# FOODCHAT_FOODLOG_URL=https://script.google.com/macros/s/.../exec
# Longest a chat turn may run before it is stopped. Default 15 minutes.
# FOODCHAT_TURN_CEILING_MS=900000
# Tim's Slack user ID, for replies in mirror threads. Default: the first
# ALLOWED_USER_IDS entry.
# FOODCHAT_TIM_USER_ID=U0123456789
